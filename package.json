{
  "name": "comanda-chef-app",
  "version": "1.6.0",
  "private": true,
  "description": "App gestionale per chef: ricettario con food cost, brigata, turni, assistente AI.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && wrangler pages dev dist --port 4173",
    "test": "node --experimental-strip-types --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint:import": "node scripts/controlla-import.cjs",
    "lint:token": "node scripts/controlla-token.cjs",
    "lint:js": "eslint app/src tests scripts",
    "icone": "node scripts/genera-icone.cjs",
    "lint:lingue": "node scripts/controlla-lingue.cjs"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "fast-xml-parser": "^5.11.1",
    "lit": "^3.3.3",
    "node-forge": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  }
}
